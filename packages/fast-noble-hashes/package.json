{
  "name": "@r1ck404/fast-noble-hashes",
  "version": "1.8.0",
  "description": "Faster drop-in replacement for @noble/hashes 1.8.0: SHA-2, SHA-1, MD5, HMAC, PBKDF2 and scrypt in WebAssembly, identical results, errors and instance state",
  "keywords": [
    "noble",
    "hashes",
    "sha256",
    "sha512",
    "sha1",
    "md5",
    "hmac",
    "pbkdf2",
    "scrypt",
    "wasm",
    "drop-in"
  ],
