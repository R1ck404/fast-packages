// @r1ck404/fast-es-module-lexer: drop-in replacement for es-module-lexer 1.7.0
// (same exports: ImportType, init, initSync, parse; same results, same
// errors). One module (each module costs Node ~0.5 ms to load): this code,
// then the wasm (build.mjs writes it at the end, base64).
//
// build.mjs also writes browser.mjs, the module bundlers take for browsers
// (the "browser" export condition): this code with BROWSER = true, without
// the Node.js paths, and the wasm as a denser text (see decode) instead of
// base64: ~25% smaller after gzip, but decoding it costs a few tenths of a
// millisecond that base64 in Node does not.
//
// The lexer is a port of es-module-lexer's lexer.c (rust/src/lib.rs) that
// skips over code with SIMD instead of walking it char by char. Sources go
// into wasm memory by the fastest means the engine has: Node's Buffer
// latin1Write/ucs2Write (memcpy), a wasm loop over the JS-string builtins in
// other V8 hosts (Chromium), TextEncoder.encodeInto elsewhere (Firefox and
// Safari); either way they end up as one byte per UTF-16 code unit, which is
// all the lexer distinguishes. Results come back as one int array instead
// of a wasm call per field, and import specifiers without escapes are
// sliced instead of eval'd (eval of a plain quoted literal is its body).

import type { ImportSpecifier, ExportSpecifier } from "./types/lexer.js";

/** true in browser.mjs (see above) */
const BROWSER: boolean = false;

// the globals of Deno and Bun (only tested for)
declare const Deno: unknown, Bun: unknown;

/** exports of rust/src/lib.rs */
interface LexerExports {
  memory: WebAssembly.Memory;
  /** the header's address: [status, error index, facade, hasModuleSyntax, records start, records end (byte offsets), source capacity, reads outside the source] (i32 each) */
  HDR: WebAssembly.Global;
  /** source buffer of at least n bytes */
  buf(n: number): number;
  parse8(len: number): number;
  parse16(len: number): number;
  parse_utf8(len: number, n: number): number;
}
/** copy8(string, from, to, base, mask, useCharCodeAt): the JS-string builtins copy loop */
type Copy8 = (s: string, from: number, to: number, base: number, mask: number, cca: number) => void;
type ParseResult = readonly [imports: ReadonlyArray<ImportSpecifier>, exports: ReadonlyArray<ExportSpecifier>, facade: boolean, hasModuleSyntax: boolean];

/** es-module-lexer's ImportType enum: name -> number and number -> name */
export const ImportType: Record<string | number, string | number> = {};
"Static Dynamic ImportMeta StaticSourcePhase DynamicSourcePhase StaticDeferPhase DynamicDeferPhase"
  .split(" ")
  .forEach((k, i) => (ImportType[(ImportType[k] = i + 1)] = k));

const b64 = (s: string): Uint8Array<ArrayBuffer> =>
  !BROWSER && typeof Buffer === "function" ? Buffer.from(s, "base64") : Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

// browser.mjs: the modules are text (see build.mjs): the first 64 characters
// say which bytes are one character, the others are two; a small wasm
// module (base64) turns the text back into bytes.
let decoder: WebAssembly.Module | undefined;
let enc: TextEncoder | undefined;
function decode(text: string): Uint8Array<ArrayBuffer> {
  decoder ||= new WebAssembly.Module(b64(DECODER()));
  const d = new WebAssembly.Instance(decoder).exports as unknown as { m: WebAssembly.Memory; d(n: number): number };
  // (the text at 1024, in as many pages as it needs)
  d.m.grow((text.length + 1024) >> 16);
  const n = d.d((enc ||= new TextEncoder()).encodeInto(text, new Uint8Array(d.m.buffer, 1024)).written);
  return new Uint8Array(d.m.buffer, 1024, n);
}
const bytesOf = (s: string): Uint8Array<ArrayBuffer> => (BROWSER ? decode(s) : b64(s));

let W: LexerExports | null = null;
let I32: Int32Array;
let H = 0; // header index into I32
let srcPtr = 0; // source buffer in wasm memory
let cap = -1; // capacity of the source buffer in bytes
let srcView: Uint8Array; // Uint8Array over the source buffer
// (latin1Write / ucs2Write: undocumented, in every Node version)
let NB: Buffer & { latin1Write(s: string, offset: number, length: number): number; ucs2Write(s: string, offset: number, length: number): number }; // Node: Buffer over wasm memory
let C8: Copy8 | null = null; // V8: copy8(string, from, to, base, 255, cca) (wasm JS-string builtins)
// how sources get into wasm memory: 0 Node Buffer, 1 V8 builtins, 2 encodeInto
let mode = 2;

// Node.js: Buffer's latin1Write / ucs2Write put a string into wasm memory at
// memcpy speed (TextEncoder.encodeInto is ~1-2 ns per char). Only the real
// Node: not a Buffer polyfill in a browser, not Deno's or Bun's Node APIs
// (their own paths are faster there). (Not `navigator`: in Node its first
// use builds it, ~0.1 ms.)
const isNode = (): boolean =>
  typeof process === "object" &&
  typeof process?.versions?.node === "string" &&
  typeof Deno === "undefined" &&
  typeof Bun === "undefined" &&
  typeof Buffer === "function" &&
  typeof (Buffer.prototype as any).latin1Write === "function" &&
  typeof (Buffer.prototype as any).ucs2Write === "function";
// Which of the two to use: a string's one-byte representation means all its
// chars are <= 0xff (then latin1Write is exact). v8.isStringOneByteRepresentation
// (Node >= 22.15) tells in O(1), but loading node:v8 costs ~1ms, so it is
// only fetched once a few hundred KB went through. Until then a regexp that
// cannot match a one-byte string (V8 answers that in O(1) as well; on a
// two-byte string it stops at the first char above 0xff).
let isOneByte: ((s: string) => boolean) | null = null;
let nodeChars = 0;
function loadIsOneByte(): void {
  isOneByte = (s) => !NON_LATIN1.test(s);
  try {
    const v8: any = process.getBuiltinModule("node:v8");
    if (typeof v8.isStringOneByteRepresentation === "function") isOneByte = v8.isStringOneByteRepresentation;
  } catch {}
}
const NON_LATIN1 = /[^\x00-\xff]/;

// V8 (Chromium, Deno): a wasm loop over the JS-string builtins copies a
// string 1.5-4x faster than TextEncoder.encodeInto (a scalar UTF-8 encoder in
// Blink). Firefox and Safari have a fast encodeInto and slow charCodeAt
// builtins, so they keep encodeInto.
function copyModule(): Copy8 | null {
  try {
    // V8 only (its message for property reads of null)
    try {
      JSON.parse("null").x;
    } catch (e) {
      if (!/^Cannot read propert/.test(e.message)) return null;
    }
    // (js-string builtins: the options argument is newer than lib.dom's types)
    const m = new (WebAssembly.Module as any)(bytesOf(COPY8()), { builtins: ["js-string"] }) as WebAssembly.Module;
    // without builtin support the import would have to come from JS (slow)
    if (WebAssembly.Module.imports(m).some((i) => i.module !== "env")) return null;
    return new WebAssembly.Instance(m, { env: { memory: W.memory } }).exports.copy8 as Copy8;
  } catch {
    return null;
  }
}

// copy8 reads strings with intoCharCodeArray until V8 has had the time to
// optimize it (~0.5M chars), then with charCodeAt (fastest, but ~10x slower
// than encodeInto in V8's baseline code; see build.mjs)
let c8cca = 0;
let c8chars = 0;

function setup(instance: WebAssembly.Instance): void {
  W = instance.exports as unknown as LexerExports;
  H = W.HDR.value >> 2;
  mode = !BROWSER && isNode() ? 0 : (C8 = copyModule()) ? 1 : 2;
  refresh();
}

function refresh(): void {
  const b = W.memory.buffer;
  I32 = new Int32Array(b);
  if (!BROWSER && mode === 0) NB = Buffer.from(b) as typeof NB;
  if (cap >= 0) srcView = new Uint8Array(b, srcPtr, cap);
}

/** make room for n bytes of source (and views on current memory) */
function grow(n: number): void {
  srcPtr = W.buf(n);
  cap = new Int32Array(W.memory.buffer)[H + 6];
  refresh();
}

const bytes = bytesOf(WASM());
/**
 * Wait for init to resolve before calling `parse`.
 */
export const init: Promise<void> = WebAssembly.instantiate(bytes).then((r) => {
  W || setup(r.instance);
});

export const initSync = (): void => {
  W || setup(new WebAssembly.Instance(new WebAssembly.Module(bytes)));
};

// es-module-lexer decodes quoted names with `(0, eval)(literal)`
function evalName(str: string): string | undefined {
  try {
    return (0, eval)(str);
  } catch (e) {}
}

// es-module-lexer's glue for a source that is not a string: `length + 1`
// units of memory, filled by charCodeAt (the same TypeError for null,
// undefined and objects without charCodeAt, the same RangeError for a
// negative length), lexed as `length` chars.
function fromObject(A: any): string {
  const u = new Uint16Array(A.length + 1);
  for (let i = 0, n = A.length; i < n; ) u[i] = A.charCodeAt(i++);
  let s = "";
  for (let i = 0; i < u.length - 1; i += 4096) s += String.fromCharCode.apply(null, u.subarray(i, Math.min(i + 4096, u.length - 1)));
  return s;
}

let cachedSource: string | null = null;
let cachedTail = "";

/**
 * Outputs the list of exports and locations of import specifiers,
 * including dynamic import and import meta handling.
 *
 * @param source Source code to parser
 * @param name Optional sourcename
 * @returns Tuple contaning imports list and exports list.
 */
export function parse(source: string, name?: string): ParseResult;
export function parse(source: any, name = "@"): ParseResult | Promise<ParseResult> {
  if (!W) return init.then(() => parse(source));
  if (typeof source !== "string") source = fromObject(source);

  const len = source.length;
  if (!(cachedSource !== null && I32.length !== 0 && len === cachedSource.length && source.endsWith(cachedTail) && source === cachedSource)) {
    cachedSource = null;
    // bytes per UTF-16 unit: UTF-16 (Node, two-byte strings), bytes (V8), UTF-8
    const need = mode === 1 ? len : !BROWSER && mode === 0 ? 2 * len : 3 * len;
    // (a memory.grow, also in a parse that trapped, detaches the old buffer:
    // its views read as empty)
    if (need > cap || I32.length === 0) grow(need);
    const outsideBefore = I32[H + 7];

    let status = -1;
    if (!BROWSER && mode === 0) {
      if (isOneByte === null && (nodeChars += len) > 262144) loadIsOneByte();
      if (isOneByte !== null ? isOneByte(source) : !NON_LATIN1.test(source)) {
        NB.latin1Write(source, srcPtr, len);
        status = W.parse8(len);
      } else {
        NB.ucs2Write(source, srcPtr, len * 2);
        status = W.parse16(len);
      }
    } else if (mode === 1) {
      C8(source, 0, len, srcPtr, 255, c8cca);
      if (c8cca === 0 && (c8chars += len) > 1e6) c8cca = 1;
      status = W.parse8(len);
    } else {
      if (len <= 128) {
        // a JS copy beats the fixed cost of encodeInto for short strings
        // (Latin-1 bytes are as good as the reduced form, see parse16)
        let any = 0;
        for (let i = 0; i < len; i++) any |= srcView[i] = source.charCodeAt(i);
        if (any < 256) status = W.parse8(len);
      }
      if (status < 0) {
        // UTF-8 into wasm memory; the wasm side reduces it to one byte per
        // UTF-16 code unit (a no-op for ASCII) so positions are UTF-16 indices
        const written = (enc ||= new TextEncoder()).encodeInto(source, srcView).written;
        status = written === len ? W.parse8(len) : W.parse_utf8(len, written);
      }
    }
    if (I32.length === 0) refresh();

    if (status !== 0) {
      const e = I32[H + 1];
      throw Object.assign(
        new Error(`Parse error ${name}:${source.slice(0, e).split("\n").length}:${e - source.lastIndexOf("\n", e - 1)}`),
        { idx: e },
      );
    }

    // the records in the order they were made: an import is 9 ints (kind 1, or
    // 3 if dropped), an export 5 (kind 2)
    // Records already belong to WASM. Keep just one bounded source key;
    // every result object and decoded name is still produced afresh below.
    if (len >= 4096 && len <= 1048576 && I32[H + 7] === outsideBefore) {
      cachedSource = source;
      cachedTail = source.slice(-32);
    }
  }
  const I = I32;
  const start = I[H + 4] >> 2, end = I[H + 5] >> 2;
  const facade = !!I[H + 2], syntax = !!I[H + 3];
  const imports: ImportSpecifier[] = [];
  const exports: ExportSpecifier[] = [];
  for (let o = start; o < end; ) {
    const kind = I[o];
    if (kind !== 2) {
      if (kind === 1) {
        const s = I[o + 1], e = I[o + 2], ss = I[o + 3], se = I[o + 4], d = I[o + 5], a = I[o + 6], t = I[o + 7], f = I[o + 8];
        // (static: s..e is the body of the literal; dynamic: the literal)
        let n: string | undefined;
        if (f === 1) n = d === -1 ? source.slice(s, e) : source.slice(s + 1, e - 1);
        else if (f !== 0) n = evalName(d === -1 ? source.slice(s - 1, e + 1) : source.slice(s, e));
        imports.push({ n, t, s, e, ss, se, d, a });
      }
      o += 9;
      continue;
    }
    const s = I[o + 1], e = I[o + 2], ls = I[o + 3], le = I[o + 4];
    o += 5;
    let n = source.slice(s, e);
    let c = source.charCodeAt(s);
    if ((c === 34 || c === 39) && s < e) n = evalName(n);
    let ln: string | undefined;
    if (ls >= 0) {
      ln = source.slice(ls, le);
      c = source.charCodeAt(ls);
      if ((c === 34 || c === 39) && ls < le) ln = evalName(ln);
    }
    exports.push({ s, e, ls, le, n, ln });
  }
  return [imports, exports, facade, syntax] as ParseResult;
}

// ---- test hooks (not exported: test/hooks.mjs loads this module with an
// export of them added)

/** force how sources are copied ("node" | "node-re" | "v8" | "v8-into" | "encode") */
function __mode(m: string): void {
  cachedSource = null;
  initSync();
  if (m === "node" && !BROWSER && isNode()) (mode = 0), loadIsOneByte();
  else if (m === "node-re" && !BROWSER && isNode()) (mode = 0), (isOneByte = (s) => !NON_LATIN1.test(s));
  else if ((m === "v8" || m === "v8-into") && (C8 ||= copyModule())) (mode = 1), (c8cca = m === "v8" ? 1 : 0), (c8chars = -Infinity);
  else if (m === "encode") mode = 2;
  else throw new Error("mode not available: " + m);
  refresh();
}
/** how sources are copied now, and how many reads the lexer made outside a source so far */
function __stats(): { mode: string; outside: number } {
  initSync();
  return { mode: ["node", "v8", "encode"][mode], outside: I32[H + 7] };
}

// generated by build.mjs (everything below this line)
/** the lexer (rust/), base64 (browser.mjs: as text, see build.mjs) */
function WASM(): string {
  return "";
}
/** the string-copy module (build.mjs), base64 (browser.mjs: as text) */
function COPY8(): string {
  return "";
}
/** browser.mjs: the decoder of the text (rust/decode.wat), base64 */
function DECODER(): string {
  return "";
}
